# Tandem — environment variables
# Copy to .env for local runs. NEVER commit a real .env with tokens.
# All values below are placeholders.

# --- Mode -----------------------------------------------------------------
# DEMO_MODE=true runs entirely on in-memory fixtures: no tokens needed,
# no network calls to GitHub/Jira/Notion. This is how to try Tandem
# without any accounts. Leave unset/false for live mode.
DEMO_MODE=true

# --- GitHub ---------------------------------------------------------------
GITHUB_TOKEN=ghp_REPLACE_ME
# "owner/repo" used when a tool call doesn't pass repo explicitly.
GITHUB_REPO=lalolalo1999/tandem-demo

# --- Jira -----------------------------------------------------------------
JIRA_BASE_URL=https://your-site.atlassian.net
JIRA_EMAIL=you@example.com
JIRA_API_TOKEN=REPLACE_ME
JIRA_PROJECT=TAN

# --- Notion ---------------------------------------------------------------
NOTION_API_KEY=secret_REPLACE_ME
# Page under which Tandem creates work docs (share it with the integration).
NOTION_PARENT_PAGE_ID=REPLACE_ME
NOTION_STATUS_PROPERTY=Status

# --- Observability (optional — off unless set) ---------------------------
# PostHog product analytics: one event per tool call (tool name, duration,
# success, Jira key / repo / doc id). Never tokens or content.
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com
# Sentry error tracking: exceptions from tool handlers and transport errors.
SENTRY_DSN=

# --- Local HTTP transport -------------------------------------------------
PORT=3000
HOST=127.0.0.1
